[gd_resource type="Theme" load_steps=12 format=3 uid="uid://cartoon_theme_trac_run"]

; ---------------------------------------------------------------
; Palet warna kartun:
;  Primary   = biru langit cerah   (#3DD6F5)
;  Secondary = kuning matahari     (#FFC93C)
;  Accent    = pink/merah aksi     (#FF5E6C)
;  Outline   = navy gelap untuk garis tepi kartun (#1B1F3B)
;  Text      = putih dengan outline navy untuk kontras
; ---------------------------------------------------------------

[sub_resource type="StyleBoxFlat" id="btn_normal"]
bg_color = Color(0.24, 0.84, 0.96, 1)
corner_radius_top_left = 28
corner_radius_top_right = 28
corner_radius_bottom_left = 28
corner_radius_bottom_right = 28
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 10
border_color = Color(0.106, 0.122, 0.231, 1)
shadow_color = Color(0, 0, 0, 0.25)
shadow_size = 6
shadow_offset = Vector2(0, 4)

[sub_resource type="StyleBoxFlat" id="btn_hover"]
bg_color = Color(0.32, 0.88, 0.98, 1)
corner_radius_top_left = 28
corner_radius_top_right = 28
corner_radius_bottom_left = 28
corner_radius_bottom_right = 28
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 10
border_color = Color(0.106, 0.122, 0.231, 1)
shadow_color = Color(0, 0, 0, 0.25)
shadow_size = 6
shadow_offset = Vector2(0, 4)

[sub_resource type="StyleBoxFlat" id="btn_pressed"]
bg_color = Color(0.18, 0.7, 0.82, 1)
corner_radius_top_left = 28
corner_radius_top_right = 28
corner_radius_bottom_left = 28
corner_radius_bottom_right = 28
border_width_left = 6
border_width_top = 6
border_width_right = 6
border_width_bottom = 4
border_color = Color(0.106, 0.122, 0.231, 1)
shadow_size = 0

[sub_resource type="StyleBoxFlat" id="panel_card"]
bg_color = Color(1, 0.98, 0.9, 1)
corner_radius_top_left = 36
corner_radius_top_right = 36
corner_radius_bottom_left = 36
corner_radius_bottom_right = 36
border_width_left = 8
border_width_top = 8
border_width_right = 8
border_width_bottom = 8
border_color = Color(0.106, 0.122, 0.231, 1)
shadow_color = Color(0, 0, 0, 0.3)
shadow_size = 14
shadow_offset = Vector2(0, 8)

[sub_resource type="StyleBoxFlat" id="pill_dark"]
bg_color = Color(0.106, 0.122, 0.231, 0.82)
corner_radius_top_left = 26
corner_radius_top_right = 26
corner_radius_bottom_left = 26
corner_radius_bottom_right = 26
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(1, 1, 1, 0.18)

[sub_resource type="StyleBoxFlat" id="pause_circle"]
bg_color = Color(1, 0.79, 0.24, 1)
corner_radius_top_left = 40
corner_radius_top_right = 40
corner_radius_bottom_left = 40
corner_radius_bottom_right = 40
border_width_left = 5
border_width_top = 5
border_width_right = 5
border_width_bottom = 5
border_color = Color(0.106, 0.122, 0.231, 1)
shadow_color = Color(0, 0, 0, 0.25)
shadow_size = 5
shadow_offset = Vector2(0, 3)

[resource]
default_font_size = 26
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/focus = SubResource("btn_normal")
Button/styles/disabled = SubResource("btn_pressed")
Button/colors/font_color = Color(0.106, 0.122, 0.231, 1)
Button/colors/font_hover_color = Color(0.106, 0.122, 0.231, 1)
Button/colors/font_pressed_color = Color(0.106, 0.122, 0.231, 1)
Button/font_sizes/font_size = 28
Panel/styles/panel = SubResource("panel_card")
Label/colors/font_color = Color(1, 1, 1, 1)
Label/colors/font_outline_color = Color(0.106, 0.122, 0.231, 1)
Label/constants/outline_size = 6
Label/font_sizes/font_size = 26
